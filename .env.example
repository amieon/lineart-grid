# 阿里云百炼(DashScope) API Key，必填
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 图像编辑模型：qwen-image-edit / qwen-image-edit-plus / qwen-image-edit-max / qwen-image-2.0-pro
QWEN_IMAGE_MODEL=qwen-image-edit-plus

# 接口地址。默认走通用域名；若你的 key 绑定工作空间，改成
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# 是否让模型自动扩写提示词（线稿转换建议 false，避免改变原图结构）
QWEN_PROMPT_EXTEND=false

# 本地服务端口
PORT=5173
